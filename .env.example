# ==============================================================================
# ZeroRoute SaaS — Environment Configuration Template
# Copy this file to .env.local for local development or set in your production host
# ==============================================================================

# Application Base URL
APP_URL=http://localhost:3000

# Superadmin Credentials (Web Dashboard Access)
ADMIN_EMAIL=mapkisolutions@gmail.com
ADMIN_PASSWORD=your_secure_admin_password

# Master AI Gateway Inference Key (For Python/OpenAI SDK / cURL Inference)
ROUTER_API_KEY=zr_live_master_secret_key

# Gateway Performance & Circuit Breaker Tuning (Optional)
# TIMEOUT_MS=12000      # Max time in ms per provider before cascading failover (default: 12000)
# COOLDOWN_MS=60000     # Time in ms a 429/5xx provider is benched before retry (default: 60000)

# Dodo Payments Integration (SaaS Subscription & Invoicing)
DODO_ENVIRONMENT=test_mode # or live_mode
DODO_API_KEY=your_dodo_api_key
DODO_PRODUCT_ID=pdt_0Nml3W2yZao32si4mSs6b
DODO_WEBHOOK_SECRET=whsec_your_dodo_webhook_secret

# Transactional Email (Resend or Custom Webhook - Optional)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="ZeroRoute <mapkisolutions@gmail.com>"

# Database Configuration (Optional: defaults to local SQLite in data/zeroroute.db)
# USE_CLOUDFLARE_D1=true
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
# CLOUDFLARE_D1_DATABASE_ID=your_cloudflare_d1_database_id
# CLOUDFLARE_D1_TOKEN=your_cloudflare_d1_api_token

# ==============================================================================
# AI Provider API Keys (Free / Tier-1 API Keys for Multi-Cloud Fallback Matrix)
# ==============================================================================
GROQ_API_KEY=gsk_...
CEREBRAS_API_KEY=csk-...
SAMBANOVA_API_KEY=...
MISTRAL_API_KEY=...
COHERE_API_KEY=...
GEMINI_API_KEY=...
OPENROUTER_API_KEY=sk-or-...
NVIDIA_API_KEY=nvapi-...
HUGGINGFACE_API_KEY=hf_...
BAZAARLINK_API_KEY=...
CLOUDFLARE_API_TOKEN=...
